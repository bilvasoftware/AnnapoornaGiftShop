    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Areas\Admin\Models\" />
    <Folder Include="Areas\Admin\Product\" />
    <Folder Include="Documentation\Demo\" />
    <Folder Include="Documentation\Screenshots\" />
    <Folder Include="Helpers\" />
    <Folder Include="wwwroot\images\categories\" />
    <Folder Include="wwwroot\images\banners\" />
