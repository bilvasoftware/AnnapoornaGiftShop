@model GiftShop.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold mb-0">
            <i class="fa-solid fa-cart-shopping"></i>
            Shopping Cart
        </h2>

        <a asp-controller="Home"
           asp-action="Shop"
           class="btn btn-outline-primary">

            <i class="fa-solid fa-store"></i>
            Continue Shopping

        </a>

    </div>


    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">

            <i class="fa-solid fa-circle-info"></i>

            Your shopping cart is empty.

        </div>
    }
    else
    {
        <div class="row g-4">

            <!-- CART ITEMS -->

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body p-0">

                        <div class="table-responsive">

                            <table class="table align-middle mb-0">

                                <thead class="table-light">

                                    <tr>

                                        <th class="ps-4">
                                            Product
                                        </th>

                                        <th>
                                            Price
                                        </th>

                                        <th>
                                            Qty
                                        </th>

                                        <th>
                                            Total
                                        </th>

                                        <th>
                                            Action
                                        </th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>

                                            <!-- PRODUCT -->

                                            <td class="ps-4">

                                                <div class="d-flex align-items-center gap-3">

                                                    <img src="~/images/products/@item.ProductImage"
                                                         class="rounded"
                                                         style="width:70px;height:70px;object-fit:contain;"
                                                         alt="@item.ProductName" />

                                                    <div>

                                                        <div class="fw-bold">
                                                            @item.ProductName
                                                        </div>

                                                    </div>

                                                </div>

                                            </td>


                                            <!-- PRICE -->

                                            <td>

                                                ₹@item.Price.ToString("N2")

                                            </td>


                                            <!-- QUANTITY -->

                                            <td>

                                                <div class="d-flex align-items-center">

                                                    <a asp-controller="Cart"
                                                       asp-action="Decrease"
                                                       asp-route-id="@item.ProductId"
                                                       class="btn btn-sm btn-outline-secondary">

                                                        −

                                                    </a>

                                                    <span class="mx-2 fw-bold">

                                                        @item.Quantity

                                                    </span>

                                                    <a asp-controller="Cart"
                                                       asp-action="Increase"
                                                       asp-route-id="@item.ProductId"
                                                       class="btn btn-sm btn-outline-secondary">

                                                        +

                                                    </a>

                                                </div>

                                            </td>


                                            <!-- TOTAL -->

                                            <td>

                                                <strong>
                                                    ₹@item.Total.ToString("N2")
                                                </strong>

                                            </td>


                                            <!-- REMOVE -->

                                            <td>

                                                <a asp-controller="Cart"
                                                   asp-action="Remove"
                                                   asp-route-id="@item.ProductId"
                                                   class="btn btn-sm btn-outline-danger">

                                                    <i class="fa-solid fa-trash"></i>

                                                </a>

                                            </td>

                                        </tr>


                                        <!-- PRODUCT TAX + SHIPPING -->

                                        <tr>

                                            <td colspan="5"
                                                class="pt-0 pb-3 ps-4">

                                                <small class="text-muted">

                                                    GST
                                                    (@item.GstPercentage.ToString("0.##")%):
                                                    <strong>
                                                        ₹@item.GSTAmount.ToString("N2")
                                                    </strong>

                                                    <span class="mx-2">|</span>

                                                    Shipping:
                                                    @if (item.ShippingAmount > 0)
                                                    {
                                                        <strong>
                                                            ₹@item.ShippingAmount.ToString("N2")
                                                        </strong>
                                                    }
                                                    else
                                                    {
                                                        <strong class="text-success">
                                                            FREE
                                                        </strong>
                                                    }

                                                </small>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ORDER SUMMARY -->

            <div class="col-lg-4">

                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body p-4">

                        <h4 class="fw-bold mb-4">

                            Order Summary

                        </h4>


                        <!-- SUBTOTAL -->

                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                Subtotal
                            </span>

                            <strong>
                                ₹@Model.SubTotal.ToString("N2")
                            </strong>

                        </div>


                        <!-- GST -->

                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                GST
                            </span>

                            <strong>
                                ₹@Model.GST.ToString("N2")
                            </strong>

                        </div>


                        <!-- SHIPPING -->

                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                Shipping
                            </span>

                            @if (Model.Shipping > 0)
                            {
                                <strong>
                                    ₹@Model.Shipping.ToString("N2")
                                </strong>
                            }
                            else
                            {
                                <strong class="text-success">
                                    FREE
                                </strong>
                            }

                        </div>


                        <hr />


                        <!-- GRAND TOTAL -->

                        <div class="d-flex justify-content-between mb-4">

                            <h5 class="fw-bold mb-0">
                                Grand Total
                            </h5>

                            <h5 class="fw-bold text-success mb-0">

                                ₹@Model.GrandTotal.ToString("N2")

                            </h5>

                        </div>


                        <!-- CHECKOUT -->

                        <div class="d-grid">

                            <a asp-controller="Checkout"
                               asp-action="Index"
                               class="btn btn-success btn-lg">

                                <i class="fa-solid fa-credit-card"></i>

                                Proceed to Checkout

                            </a>

                        </div>

                    </div>

                </div>


                <!-- INFORMATION -->

                <div class="alert alert-light border mt-3">

                    <small class="text-muted">

                        <i class="fa-solid fa-circle-info"></i>

                        GST and shipping charges are calculated
                        according to each individual product.

                    </small>

                </div>

            </div>

        </div>
    }

</div>