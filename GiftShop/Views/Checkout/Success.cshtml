@model GiftShop.Models.Order

@{
    ViewData["Title"] = "Reservation Successful";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-5 text-center">

                    <div class="mb-4">

                        <div class="text-success"
                             style="font-size:60px;">

                            <i class="bi bi-check-circle-fill"></i>

                        </div>

                    </div>

                    <h2 class="fw-bold mb-2">
                        Reservation Successful!
                    </h2>

                    <p class="text-muted mb-4">
                        Your selected products have been reserved successfully.
                    </p>


                    <!-- TOKEN -->

                    <div class="bg-light rounded-4 p-4 mb-4">

                        <p class="text-muted mb-2">
                            Your Token Number
                        </p>

                        <h1 class="fw-bold text-primary mb-0">

                            @Model.TokenNumber

                        </h1>

                        <small class="text-muted">
                            Please save this token number.
                        </small>

                    </div>


                    <!-- ORDER INFORMATION -->

                    <div class="row text-start g-3 mb-4">

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted">
                                    Order Number
                                </small>

                                <div class="fw-bold">
                                    @Model.OrderNumber
                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted">
                                    Order Date
                                </small>

                                <div class="fw-bold">

                                    @Model.OrderDate.ToString("dd-MM-yyyy hh:mm tt")

                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted">
                                    Payment Method
                                </small>

                                <div class="fw-bold">

                                    @Model.PaymentMethod

                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted">
                                    Order Status
                                </small>

                                <div>

                                    <span class="badge bg-primary">

                                        @Model.OrderStatus

                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- PRODUCTS -->

                    <h5 class="fw-bold text-start mb-3">
                        Reserved Products
                    </h5>

                    <div class="table-responsive">

                        <table class="table align-middle">

                            <thead class="table-light">

                                <tr>

                                    <th class="text-start">
                                        Product
                                    </th>

                                    <th>
                                        Qty
                                    </th>

                                    <th>
                                        Total
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>

                                        <td class="text-start">

                                            @item.Product?.ProductName

                                        </td>

                                        <td>

                                            @item.Quantity

                                        </td>

                                        <td>

                                            ₹@item.Total.ToString("N2")

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>


                    <!-- TOTAL -->

                    <div class="text-end border-top pt-3">

                        <div class="d-flex justify-content-end gap-4 mb-2">

                            <span>
                                Subtotal
                            </span>

                            <strong>
                                ₹@Model.SubTotal.ToString("N2")
                            </strong>

                        </div>

                        <div class="d-flex justify-content-end gap-4 mb-2">

                            <span>
                                GST
                            </span>

                            <strong>
                                ₹@Model.GST.ToString("N2")
                            </strong>

                        </div>

                        <div class="d-flex justify-content-end gap-4 mb-2">

                            <span>
                                Shipping
                            </span>

                            <strong>
                                ₹@Model.Shipping.ToString("N2")
                            </strong>

                        </div>

                        <div class="d-flex justify-content-end gap-4">

                            <h5 class="fw-bold">
                                Grand Total
                            </h5>

                            <h5 class="fw-bold text-success">

                                ₹@Model.GrandTotal.ToString("N2")

                            </h5>

                        </div>

                    </div>


                    <!-- INSTRUCTION -->

                    <div class="alert alert-info text-start mt-4">

                        <i class="bi bi-info-circle-fill me-2"></i>

                        <strong>
                            Please visit our shop with your token number
                            <span class="text-primary">
                                @Model.TokenNumber
                            </span>
                            to collect your reserved products.
                        </strong>

                        <br />

                        <small>
                            Payment can be made at the shop.
                        </small>

                    </div>


                    <!-- BUTTONS -->

                    <div class="d-flex justify-content-center gap-2 mt-4">

                        <a asp-controller="Home"
                           asp-action="Shop"
                           class="btn btn-primary">

                            <i class="bi bi-shop me-1"></i>

                            Continue Shopping

                        </a>

                        <button type="button"
                                onclick="window.print()"
                                class="btn btn-outline-secondary">

                            <i class="bi bi-printer me-1"></i>

                            Print Token

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>