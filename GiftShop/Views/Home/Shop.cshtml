@model GiftShop.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Shop";
}

<section class="container py-5">

    <div class="text-center mb-5">

        <div class="bg-dark text-white rounded-4 p-5 mb-5 text-center">

            <h1 class="display-4 fw-bold">
                Our Gift Collection
            </h1>

            <p class="lead">
                Browse all available products.
            </p>

        </div>

        <p class="text-muted">
            Browse all our available gift products.
        </p>

    </div>

    <div class="row g-4">

        @foreach (var product in Model.Products)
        {
            <div class="col-lg-3 col-md-6">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <img src="~/images/products/@product.ProductImage"
                         class="card-img-top p-3"
                         style="height:240px;object-fit:contain;"
                         alt="@product.ProductName" />

                    <div class="card-body d-flex flex-column text-center">

                        <h5 class="fw-bold">
                            @product.ProductName
                        </h5>

                        <p class="text-muted">
                            @product.Brand
                        </p>

                        @if (product.OfferPrice.HasValue)
                        {
                            <h5>

                                <span class="text-danger fw-bold">
                                    ₹@product.OfferPrice
                                </span>

                                <small class="text-decoration-line-through text-muted">
                                    ₹@product.Price
                                </small>

                            </h5>
                        }
                        else
                        {
                            <h5 class="text-primary fw-bold">
                                ₹@product.Price
                            </h5>
                        }

                        <a asp-controller="Home"
                           asp-action="Details"
                           asp-route-id="@product.ProductId"
                           class="btn btn-primary mt-auto">

                            View Product

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</section>