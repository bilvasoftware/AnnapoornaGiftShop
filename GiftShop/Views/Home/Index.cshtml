@model GiftShop.ViewModels.HomeViewModel

<section class="hero py-5">

    <div id="heroCarousel"
         class="carousel slide"
         data-bs-ride="carousel"
         data-bs-interval="3000"
         data-bs-pause="false">

        <div class="carousel-inner">

            @{
                int bannerIndex = 0;
            }

            @foreach (var banner in Model.Banners)
            {
                <div class="carousel-item @(bannerIndex == 0 ? "active" : "")">

                    <div class="container">

                        <div class="row align-items-center">

                            <div class="col-lg-6">

                                <span class="badge bg-warning text-dark mb-3">
                                    New Collection
                                </span>

                                <h1 class="display-4 fw-bold">
                                    @banner.Title
                                </h1>

                                <p class="lead">
                                    @banner.SubTitle
                                </p>

                                @if (!string.IsNullOrWhiteSpace(banner.ButtonText))
                                {
                                    <a href="@banner.ButtonLink"
                                       class="btn btn-primary btn-lg mt-3">

                                        @banner.ButtonText

                                    </a>
                                }

                            </div>

                            <div class="col-lg-6 text-center">

                                <img src="~/images/banners/@banner.BannerImage"
                                     class="img-fluid hero-image"
                                     alt="@banner.Title" />

                            </div>

                        </div>

                    </div>

                </div>

                bannerIndex++;
            }

        </div>

        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#heroCarousel"
                data-bs-slide="prev">

            <span class="carousel-control-prev-icon"></span>

        </button>

        <button class="carousel-control-next"
                type="button"
                data-bs-target="#heroCarousel"
                data-bs-slide="next">

            <span class="carousel-control-next-icon"></span>

        </button>

    </div>

</section>
<section class="container py-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold">
            Shop By Category
        </h2>

        <p class="text-muted">
            Find the perfect gift for every special occasion.
        </p>

    </div>

    <div class="row g-4">

        @foreach (var item in Model.Categories)
        {
            <div class="col-lg-3 col-md-6">

                <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-3">

                    <img src="~/images/categories/@item.CategoryImage"
                         class="img-fluid mx-auto mb-3"
                         style="height:180px;object-fit:contain;"
                         alt="@item.CategoryName" />

                    <h5 class="fw-bold">
                        @item.CategoryName
                    </h5>

                    <p class="text-muted mb-0">
                        Explore our @item.CategoryName gifts.
                    </p>

                </div>

            </div>
        }

    </div>

</section>

<section class="container py-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold">
            Featured Products
        </h2>

        <p class="text-muted">
            Our most popular gift collections.
        </p>

    </div>

    <div class="row g-4">

        @foreach (var product in Model.Products.Where(x => x.IsFeatured))
        {
            <div class="col-lg-3 col-md-6">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <img src="~/images/products/@product.ProductImage"
                         class="card-img-top p-3"
                         style="height:250px;object-fit:contain;"
                         alt="@product.ProductName" />

                    <div class="card-body d-flex flex-column text-center">

                        <h5 class="fw-bold">
                            @product.ProductName
                        </h5>

                        <p class="text-muted">
                            @product.Brand
                        </p>

                        @if (product.OfferPrice.HasValue)
                        {
                            <h5>

                                <span class="text-danger fw-bold">
                                    ₹@product.OfferPrice
                                </span>

                                <small class="text-decoration-line-through text-muted">
                                    ₹@product.Price
                                </small>

                            </h5>
                        }
                        else
                        {
                            <h5 class="text-primary fw-bold">
                                ₹@product.Price
                            </h5>
                        }

                        <a asp-controller="Home"
                           asp-action="Details"
                           asp-route-id="@product.ProductId"
                           class="btn btn-primary mt-auto">

                            View Product

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</section>

