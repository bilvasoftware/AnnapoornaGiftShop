                    <img src="~/images/products/@product.ProductImage"
                         class="card-img-top p-3"
                         style="height:250px;object-fit:contain;"
                         alt="@product.ProductName" />

                    <div class="card-body d-flex flex-column text-center">

                        <span class="badge bg-success mb-2">
                            New
                        </span>

                        <h5 class="fw-bold">
                            @product.ProductName
                        </h5>

                        <p class="text-muted">
                            @product.Brand
                        </p>

                        @if (product.OfferPrice.HasValue)
                        {
                            <h5>
                                <span class="text-danger fw-bold">
                                    ₹@product.OfferPrice
                                </span>

                                <small class="text-decoration-line-through text-muted">
                                    ₹@product.Price
                                </small>
                            </h5>
                        }
                        else
                        {
                            <h5 class="text-primary fw-bold">
                                ₹@product.Price
                            </h5>
                        }

                        <a asp-controller="Home"
                           asp-action="Details"
                           asp-route-id="@product.ProductId"
                           class="btn btn-success mt-auto">

                            View Product

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</section>

<section class="container py-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold">
            Best Sellers
        </h2>

        <p class="text-muted">
            Our customers' favorite gift collections.
        </p>

    </div>

    <div class="row g-4">

        @foreach (var product in Model.Products.Where(x => x.IsBestSeller))
        {
            <div class="col-lg-3 col-md-6">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <img src="~/images/products/@product.ProductImage"
                         class="card-img-top p-3"
                         style="height:250px;object-fit:contain;"
                         alt="@product.ProductName" />

                    <div class="card-body d-flex flex-column text-center">

                        <span class="badge bg-danger mb-2">
                            Best Seller
                        </span>

                        <h5 class="fw-bold">
                            @product.ProductName
                        </h5>

                        <p class="text-muted">
                            @product.Brand
                        </p>

                        @if (product.OfferPrice.HasValue)
                        {
                            <h5>

                                <span class="text-danger fw-bold">
                                    ₹@product.OfferPrice
                                </span>

                                <small class="text-decoration-line-through text-muted">
                                    ₹@product.Price
                                </small>

                            </h5>
                        }
                        else
                        {
                            <h5 class="text-primary fw-bold">
                                ₹@product.Price
                            </h5>
                        }

                        <a asp-controller="Home"
                           asp-action="Details"
                           asp-route-id="@product.ProductId"
                           class="btn btn-danger mt-auto">

                            View Product

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</section>

<section class="container py-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold">
            Our Brands
        </h2>

        <p class="text-muted">
            We proudly offer products from trusted brands.
        </p>

    </div>

    <div id="brandCarousel"
         class="carousel slide"
         data-bs-ride="carousel"
         data-bs-interval="2500"
         data-bs-pause="false">

        <div class="carousel-inner">

            @{
                int brandIndex = 0;
            }

            @foreach (var brand in Model.Brands)
            {
                <div class="carousel-item @(brandIndex == 0 ? "active" : "")">

                    <div class="text-center">

                        <img src="~/images/brands/@brand.BrandLogo"
                             class="img-fluid"
                             style="max-height:120px;object-fit:contain;"
                             alt="@brand.BrandName" />

                        <h5 class="mt-3">
                            @brand.BrandName
                        </h5>

                    </div>

                </div>

                brandIndex++;
            }

        </div>

        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#brandCarousel"
                data-bs-slide="prev">

            <span class="carousel-control-prev-icon"></span>

        </button>

        <button class="carousel-control-next"
                type="button"
                data-bs-target="#brandCarousel"
                data-bs-slide="next">

            <span class="carousel-control-next-icon"></span>

        </button>

    </div>

</section>
