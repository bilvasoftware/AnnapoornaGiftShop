@model IEnumerable<GiftShop.Models.Order>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h3 class="mb-1">
            Orders
        </h3>

        <p class="text-muted mb-0">
            Manage customer reservations and orders
        </p>
    </div>

</div>


<!-- ========================= -->
<!-- SEARCH ORDERS -->
<!-- ========================= -->

<div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-body">

        <form asp-area="Admin"
              asp-controller="Order"
              asp-action="Index"
              method="get">

            <div class="row g-2 align-items-center">

                <div class="col-md-10">

                    <div class="input-group">

                        <span class="input-group-text bg-white">

                            <i class="bi bi-search"></i>

                        </span>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search by Token Number or Mobile Number..." />

                    </div>

                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="bi bi-search me-1"></i>

                        Search

                    </button>

                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
            {
                <div class="mt-2">

                    <small class="text-muted">

                        Showing results for:
                        <strong>@ViewBag.Search</strong>

                    </small>

                    <a asp-area="Admin"
                       asp-controller="Order"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-secondary ms-2">

                        Clear

                    </a>

                </div>
            }

        </form>

    </div>

</div>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="card border-0 shadow-sm rounded-4">

    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-bag-x fs-1 text-muted"></i>

                <h5 class="mt-3">
                    No orders yet
                </h5>

                <p class="text-muted">
                    Customer reservations will appear here.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Token
                            </th>

                            <th>
                                Order
                            </th>

                            <th>
                                Customer
                            </th>

                            <th>
                                Mobile
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Total
                            </th>

                            <th>
                                Payment
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var order in Model)
                        {
                            <tr>

                                <!-- TOKEN -->

                                <td>

                                    <span class="badge bg-primary fs-6">

                                        @order.TokenNumber

                                    </span>

                                </td>


                                <!-- ORDER NUMBER -->

                                <td>

                                    <strong>
                                        @order.OrderNumber
                                    </strong>

                                </td>


                                <!-- CUSTOMER -->

                                <td>

                                    @order.Customer?.FullName

                                </td>


                                <!-- MOBILE -->

                                <td>

                                    @order.Customer?.MobileNumber

                                </td>


                                <!-- DATE -->

                                <td>

                                    <small>

                                        @order.OrderDate.ToString("dd-MM-yyyy")

                                        <br />

                                        @order.OrderDate.ToString("hh:mm tt")

                                    </small>

                                </td>


                                <!-- TOTAL -->

                                <td>

                                    <strong class="text-success">

                                        ₹@order.GrandTotal.ToString("N2")

                                    </strong>

                                </td>


                                <!-- PAYMENT -->

                                <td>

                                    <span class="badge bg-warning text-dark">

                                        @order.PaymentStatus

                                    </span>

                                    <br />

                                    <small class="text-muted">

                                        @order.PaymentMethod

                                    </small>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (order.OrderStatus == "Reserved")
                                    {
                                        <span class="badge bg-primary">
                                            Reserved
                                        </span>
                                    }
                                    else if (order.OrderStatus == "Confirmed")
                                    {
                                        <span class="badge bg-info text-dark">
                                            Confirmed
                                        </span>
                                    }
                                    else if (order.OrderStatus == "Ready for Pickup")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Ready for Pickup
                                        </span>
                                    }
                                    else if (order.OrderStatus == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else if (order.OrderStatus == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @order.OrderStatus
                                        </span>
                                    }

                                </td>


                                <!-- ACTION -->

                                <td>

                                    <a asp-area="Admin"
                                       asp-controller="Order"
                                       asp-action="Details"
                                       asp-route-id="@order.OrderId"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye"></i>

                                        View

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>