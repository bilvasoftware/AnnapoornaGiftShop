@model GiftShop.Models.Order

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Order Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h3 class="mb-1">
            Order Details
        </h3>

        <p class="text-muted mb-0">
            View and manage this customer reservation
        </p>
    </div>

    <a asp-area="Admin"
       asp-controller="Order"
       asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left"></i>
        Back to Orders

    </a>

</div>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="row g-4">

    <!-- ===================================================== -->
    <!-- ORDER INFORMATION -->
    <!-- ===================================================== -->

    <div class="col-lg-8">

        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-header bg-white py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="mb-0 fw-bold">
                        Reserved Products
                    </h5>

                    <span class="badge bg-primary fs-6">

                        Token:
                        @Model.TokenNumber

                    </span>

                </div>

            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Product
                                </th>

                                <th>
                                    Price
                                </th>

                                <th>
                                    Quantity
                                </th>

                                <th>
                                    Total
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <div class="d-flex align-items-center gap-3">

                                            @if (item.Product != null &&
                                                                                    !string.IsNullOrWhiteSpace(item.Product.ProductImage))
                                            {
                                                <img src="~/images/products/@item.Product.ProductImage"
                                                     style="width:60px;height:60px;object-fit:contain;"
                                                     class="rounded"
                                                     alt="@item.Product.ProductName" />
                                            }

                                            <div>

                                                <strong>
                                                    @item.Product?.ProductName
                                                </strong>

                                            </div>

                                        </div>

                                    </td>

                                    <td>
                                        ₹@item.Price.ToString("N2")
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>

                                        <strong>
                                            ₹@item.Total.ToString("N2")
                                        </strong>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- CUSTOMER -->
        <!-- ================================================= -->

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-0 fw-bold">
                    Customer Information
                </h5>

            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">

                        <small class="text-muted">
                            Customer Name
                        </small>

                        <div class="fw-bold">
                            @Model.Customer?.FullName
                        </div>

                    </div>

                    <div class="col-md-6">

                        <small class="text-muted">
                            Mobile Number
                        </small>

                        <div class="fw-bold">
                            @Model.Customer?.MobileNumber
                        </div>

                    </div>

                    <div class="col-md-6">

                        <small class="text-muted">
                            Email
                        </small>

                        <div>
                            @(string.IsNullOrWhiteSpace(Model.Customer?.Email)
                                                        ? "-"
                                                        : Model.Customer.Email)
                        </div>

                    </div>

                    <div class="col-md-6">

                        <small class="text-muted">
                            City
                        </small>

                        <div>
                            @Model.Customer?.City
                        </div>

                    </div>

                    <div class="col-12">

                        <small class="text-muted">
                            Address
                        </small>

                        <div>
                            @Model.Customer?.Address
                        </div>

                    </div>

                    <div class="col-md-6">

                        <small class="text-muted">
                            Pincode
                        </small>

                        <div>
                            @Model.Customer?.Pincode
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- RIGHT SIDE -->
    <!-- ===================================================== -->

    <div class="col-lg-4">


        <!-- ORDER SUMMARY -->

        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-0 fw-bold">
                    Order Summary
                </h5>

            </div>

            <div class="card-body">

                <div class="d-flex justify-content-between mb-3">

                    <span>
                        Order Number
                    </span>

                    <strong>
                        @Model.OrderNumber
                    </strong>

                </div>

                <div class="d-flex justify-content-between mb-3">

                    <span>
                        Token Number
                    </span>

                    <strong class="text-primary">
                        @Model.TokenNumber
                    </strong>

                </div>

                <div class="d-flex justify-content-between mb-3">

                    <span>
                        Order Date
                    </span>

                    <strong>
                        @Model.OrderDate.ToString("dd-MM-yyyy")
                    </strong>

                </div>

                <hr />

                <div class="d-flex justify-content-between mb-2">

                    <span>
                        Subtotal
                    </span>

                    <strong>
                        ₹@Model.SubTotal.ToString("N2")
                    </strong>

                </div>

                <div class="d-flex justify-content-between mb-2">

                    <span>
                        GST
                    </span>

                    <strong>
                        ₹@Model.GST.ToString("N2")
                    </strong>

                </div>

                <div class="d-flex justify-content-between mb-3">

                    <span>
                        Shipping
                    </span>

                    <strong>
                        ₹@Model.Shipping.ToString("N2")
                    </strong>

                </div>

                <hr />

                <div class="d-flex justify-content-between">

                    <h5 class="fw-bold">
                        Grand Total
                    </h5>

                    <h5 class="fw-bold text-success">

                        ₹@Model.GrandTotal.ToString("N2")

                    </h5>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- ORDER STATUS -->
        <!-- ================================================= -->

        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-0 fw-bold">
                    Order Status
                </h5>

            </div>

            <div class="card-body">

                <div class="mb-3">

                    <span class="badge bg-primary fs-6">
                        @Model.OrderStatus
                    </span>

                </div>

                <form asp-area="Admin"
                      asp-controller="Order"
                      asp-action="UpdateStatus"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.OrderId" />

                    <label class="form-label">
                        Change Status
                    </label>

                    <select name="status"
                            class="form-select mb-3">

                        <option value="Reserved"
                                selected="@(Model.OrderStatus == "Reserved")">
                            Reserved
                        </option>

                        <option value="Confirmed"
                                selected="@(Model.OrderStatus == "Confirmed")">
                            Confirmed
                        </option>

                        <option value="Ready for Pickup"
                                selected="@(Model.OrderStatus == "Ready for Pickup")">
                            Ready for Pickup
                        </option>

                        <option value="Completed"
                                selected="@(Model.OrderStatus == "Completed")">
                            Completed
                        </option>

                        <option value="Cancelled"
                                selected="@(Model.OrderStatus == "Cancelled")">
                            Cancelled
                        </option>

                    </select>

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="fa-solid fa-rotate"></i>

                        Update Status

                    </button>

                </form>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- PAYMENT -->
        <!-- ================================================= -->

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-0 fw-bold">
                    Payment
                </h5>

            </div>

            <div class="card-body">

                <p class="mb-2">

                    <strong>
                        Method:
                    </strong>

                    @Model.PaymentMethod

                </p>

                <p class="mb-3">

                    <strong>
                        Status:
                    </strong>

                    <span class="badge bg-warning text-dark">

                        @Model.PaymentStatus

                    </span>

                </p>

                <form asp-area="Admin"
                      asp-controller="Order"
                      asp-action="UpdatePaymentStatus"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.OrderId" />

                    <label class="form-label">
                        Payment Status
                    </label>

                    <select name="paymentStatus"
                            class="form-select mb-3">

                        <option value="Pending"
                                selected="@(Model.PaymentStatus == "Pending")">
                            Pending
                        </option>

                        <option value="Paid"
                                selected="@(Model.PaymentStatus == "Paid")">
                            Paid
                        </option>

                    </select>

                    <button type="submit"
                            class="btn btn-success w-100">

                        <i class="fa-solid fa-money-bill"></i>

                        Update Payment

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>