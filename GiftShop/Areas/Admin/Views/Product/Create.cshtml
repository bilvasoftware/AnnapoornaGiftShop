@model GiftShop.Areas.Admin.ViewModels.ProductViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Product";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h3>
        Add New Product
    </h3>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left"></i>

        Back

    </a>

</div>


<form asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()


    <div class="row">

        <!-- =====================================================
             LEFT SIDE
             ===================================================== -->

        <div class="col-lg-8">

            <!-- PRODUCT INFORMATION -->

            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Product Information
                    </h5>

                </div>


                <div class="card-body">

                    <!-- Product Name -->

                    <div class="mb-3">

                        <label asp-for="ProductName"
                               class="form-label">
                        </label>

                        <input asp-for="ProductName"
                               class="form-control"
                               placeholder="Enter product name" />

                        <span asp-validation-for="ProductName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Product Code + Category -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="mb-3">

                                <label class="form-label">
                                    Product Code
                                </label>

                                <input asp-for="ProductCode"
                                       class="form-control"
                                       readonly />

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="mb-3">

                                <label class="form-label">
                                    Category
                                </label>

                                <select asp-for="CategoryId"
                                        asp-items="ViewBag.Categories"
                                        class="form-select">

                                    <option value="">
                                        -- Select Category --
                                    </option>

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- Brand -->

                    <div class="mb-3">

                        <label asp-for="Brand"
                               class="form-label">

                            Brand

                        </label>

                        <input asp-for="Brand"
                               class="form-control"
                               placeholder="Enter brand" />

                    </div>


                    <!-- PRICE -->

                    <div class="row">

                        <!-- Price -->

                        <div class="col-md-4">

                            <div class="mb-3">

                                <label asp-for="Price"
                                       class="form-label">

                                    Price (₹)

                                </label>

                                <input asp-for="Price"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control"
                                       placeholder="0.00" />

                                <span asp-validation-for="Price"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- Offer Price -->

                        <div class="col-md-4">

                            <div class="mb-3">

                                <label asp-for="OfferPrice"
                                       class="form-label">

                                    Offer Price (₹)

                                </label>

                                <input asp-for="OfferPrice"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control"
                                       placeholder="0.00" />

                                <span asp-validation-for="OfferPrice"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- Stock -->

                        <div class="col-md-4">

                            <div class="mb-3">

                                <label asp-for="Stock"
                                       class="form-label">

                                    Stock

                                </label>

                                <input asp-for="Stock"
                                       type="number"
                                       min="0"
                                       class="form-control"
                                       placeholder="0" />

                                <span asp-validation-for="Stock"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         GST + SHIPPING
                         ================================================= -->

                    <div class="row">

                        <!-- GST -->

                        <div class="col-md-6">

                            <div class="mb-3">

                                <label asp-for="GstPercentage"
                                       class="form-label">

                                    <i class="bi bi-percent"></i>

                                    GST (%)

                                </label>

                                <div class="input-group">

                                    <input asp-for="GstPercentage"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           max="100"
                                           class="form-control"
                                           placeholder="18" />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>

                                <span asp-validation-for="GstPercentage"
                                      class="text-danger">
                                </span>

                                <small class="text-muted">
                                    Enter GST percentage for this gift.
                                </small>

                            </div>

                        </div>


                        <!-- Shipping -->

                        <div class="col-md-6">

                            <div class="mb-3">

                                <label asp-for="ShippingCharge"
                                       class="form-label">

                                    <i class="bi bi-truck"></i>

                                    Shipping Charge (₹)

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input asp-for="ShippingCharge"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           placeholder="50" />

                                </div>

                                <span asp-validation-for="ShippingCharge"
                                      class="text-danger">
                                </span>

                                <small class="text-muted">
                                    Enter shipping charge for this gift.
                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- PRICE PREVIEW -->

                    <div class="alert alert-light border rounded-3 mb-4">

                        <div class="d-flex align-items-center mb-2">

                            <i class="bi bi-calculator me-2"></i>

                            <strong>
                                Price Preview
                            </strong>

                        </div>

                        <div class="row">

                            <div class="col-md-4">

                                <small class="text-muted">
                                    Product Price
                                </small>

                                <div id="previewPrice">
                                    ₹0.00
                                </div>

                            </div>

                            <div class="col-md-4">

                                <small class="text-muted">
                                    GST Amount
                                </small>

                                <div id="previewGst">
                                    ₹0.00
                                </div>

                            </div>

                            <div class="col-md-4">

                                <small class="text-muted">
                                    Shipping
                                </small>

                                <div id="previewShipping">
                                    ₹0.00
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="mb-3">

                        <label asp-for="Description"
                               class="form-label">

                            Description

                        </label>

                        <textarea asp-for="Description"
                                  rows="5"
                                  class="form-control"
                                  placeholder="Enter product description">
                        </textarea>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             RIGHT SIDE
             ===================================================== -->

        <div class="col-lg-4">


            <!-- PRODUCT IMAGE -->

            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Product Image
                    </h5>

                </div>


                <div class="card-body">

                    <div class="border rounded-4 p-4 text-center"
                         style="border-style:dashed!important;">

                        <img id="previewImage"
                             src="https://placehold.co/300x300?text=Preview"
                             class="img-fluid rounded mb-3"
                             style="max-height:250px;object-fit:contain;" />


                        <input asp-for="ImageFile"
                               type="file"
                               class="form-control"
                               id="imageInput"
                               accept="image/*" />


                        <small class="text-muted d-block mt-2">

                            Choose a product image

                        </small>

                    </div>

                </div>

            </div>


            <!-- PRODUCT SETTINGS -->

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Product Settings
                    </h5>

                </div>


                <div class="card-body">


                    <!-- Featured -->

                    <div class="form-check form-switch mb-3">

                        <input asp-for="IsFeatured"
                               class="form-check-input" />

                        <label asp-for="IsFeatured"
                               class="form-check-label">

                            Featured Product

                        </label>

                    </div>


                    <!-- New Arrival -->

                    <div class="form-check form-switch mb-3">

                        <input asp-for="IsNewArrival"
                               class="form-check-input" />

                        <label asp-for="IsNewArrival"
                               class="form-check-label">

                            New Arrival

                        </label>

                    </div>


                    <!-- Best Seller -->

                    <div class="form-check form-switch mb-3">

                        <input asp-for="IsBestSeller"
                               class="form-check-input" />

                        <label asp-for="IsBestSeller"
                               class="form-check-label">

                            Best Seller

                        </label>

                    </div>


                    <!-- Active -->

                    <div class="form-check form-switch mb-4">

                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label asp-for="IsActive"
                               class="form-check-label">

                            Active

                        </label>

                    </div>


                    <!-- SAVE -->

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="fa-solid fa-floppy-disk"></i>

                        Save Product

                    </button>

                </div>

            </div>

        </div>

    </div>

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        // =========================================================
        // IMAGE PREVIEW
        // =========================================================

        document.getElementById("imageInput")
            .addEventListener("change", function (e) {

                const file = e.target.files[0];

                if (!file)
                    return;

                const reader = new FileReader();

                reader.onload = function (event) {

                    document.getElementById("previewImage").src =
                        event.target.result;

                };

                reader.readAsDataURL(file);

            });


        // =========================================================
        // PRICE PREVIEW
        // =========================================================

        const priceInput =
            document.getElementById("Price");

        const gstInput =
            document.getElementById("GstPercentage");

        const shippingInput =
            document.getElementById("ShippingCharge");


        function updatePricePreview()
        {
            const price =
                parseFloat(priceInput.value) || 0;

            const gst =
                parseFloat(gstInput.value) || 0;

            const shipping =
                parseFloat(shippingInput.value) || 0;


            const gstAmount =
                price * gst / 100;


            document.getElementById("previewPrice")
                .innerText =
                "₹" + price.toFixed(2);


            document.getElementById("previewGst")
                .innerText =
                "₹" + gstAmount.toFixed(2);


            document.getElementById("previewShipping")
                .innerText =
                "₹" + shipping.toFixed(2);
        }


        priceInput.addEventListener(
            "input",
            updatePricePreview
        );

        gstInput.addEventListener(
            "input",
            updatePricePreview
        );

        shippingInput.addEventListener(
            "input",
            updatePricePreview
        );


        updatePricePreview();

    </script>
}