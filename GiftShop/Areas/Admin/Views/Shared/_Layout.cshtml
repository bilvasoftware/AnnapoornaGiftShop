<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Annapoorna Admin
    </title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <!-- Admin CSS -->
    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

</head>

<body>

    <div class="admin-wrapper">


        <!-- ========================= -->
        <!-- SIDEBAR -->
        <!-- ========================= -->

        <aside class="sidebar">

            <!-- Logo -->

            <div class="logo text-center">

                <img src="~/images/logo/logo.png"
                     alt="Annapoorna Gift Shop"
                     class="img-fluid" />

                <h5>
                    ANNAPOORNA
                </h5>

                <small>
                    Wholesale Gift Shop
                </small>

            </div>


            <!-- Navigation -->

            <ul>

                <!-- Dashboard -->

                <li>

                    <a asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index">

                        <i class="bi bi-grid-fill"></i>

                        <span>
                            Dashboard
                        </span>

                    </a>

                </li>


                <!-- Categories -->

                <li>

                    <a asp-area="Admin"
                       asp-controller="Category"
                       asp-action="Index">

                        <i class="bi bi-tags-fill"></i>

                        <span>
                            Categories
                        </span>

                    </a>

                </li>


                <!-- Products -->

                <li>

                    <a asp-area="Admin"
                       asp-controller="Product"
                       asp-action="Index">

                        <i class="fa-solid fa-box"></i>

                        <span>
                            Products
                        </span>

                    </a>

                </li>


                <!-- Banners -->

                <li>

                    <a asp-area="Admin"
                       asp-controller="Banner"
                       asp-action="Index">

                        <i class="bi bi-images"></i>

                        <span>
                            Banners
                        </span>

                    </a>

                </li>


                <!-- Brands -->

                <li>

                    <a asp-area="Admin"
                       asp-controller="Brand"
                       asp-action="Index">

                        <i class="bi bi-award"></i>

                        <span>
                            Brands
                        </span>

                    </a>

                </li>


                <!-- Contact Messages -->

                <li>

                    <a asp-area="Admin"
                       asp-controller="ContactMessage"
                       asp-action="Index">

                        <i class="bi bi-envelope-fill"></i>

                        <span>
                            Contact Messages
                        </span>

                    </a>

                </li>


                <!-- Settings -->

                <li>

                    <a asp-area="Admin"
                       asp-controller="Settings"
                       asp-action="Index">

                        <i class="bi bi-gear-fill"></i>

                        <span>
                            Settings
                        </span>

                    </a>

                </li>

            </ul>

        </aside>


        <!-- ========================= -->
        <!-- MAIN CONTENT -->
        <!-- ========================= -->

        <main class="content">


            <!-- Top Bar -->

            <div class="topbar">

                <h3>
                    @ViewData["Title"]
                </h3>


                <div class="d-flex align-items-center gap-2">

                    <i class="bi bi-person-circle fs-4"></i>

                    <span>
                        Admin
                    </span>

                </div>

            </div>


            <!-- Page Content -->

            <div class="page-content">

                @RenderBody()

            </div>

        </main>

    </div>


    <!-- ========================= -->
    <!-- JAVASCRIPT -->
    <!-- ========================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>


    <!-- Admin JavaScript -->

    <script src="~/js/admin.js"
            asp-append-version="true"></script>


    <!-- SweetAlert2 -->

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <!-- Page-specific Scripts -->
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>