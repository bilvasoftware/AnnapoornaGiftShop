@model GiftShop.Models.ShopSetting

@{
    ViewData["Title"] = "Settings";
}

<div class="container-fluid">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <form asp-area="Admin"
          asp-controller="Settings"
          asp-action="Index"
          method="post">

        @Html.AntiForgeryToken()

        <div class="row g-4">

            <!-- Shop Information -->

            <div class="col-lg-6">

                <div class="card shadow border-0">

                    <div class="card-header bg-white">

                        <h5 class="mb-0">
                            <i class="bi bi-shop"></i>
                            Shop Information
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="mb-3">

                            <label asp-for="ShopName"
                                   class="form-label">
                                Shop Name
                            </label>

                            <input asp-for="ShopName"
                                   class="form-control" />

                            <span asp-validation-for="ShopName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3">
                            </textarea>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Phone"
                                   class="form-label">
                                Phone Number
                            </label>

                            <input asp-for="Phone"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="WhatsAppNumber"
                                   class="form-label">
                                WhatsApp Number
                            </label>

                            <input asp-for="WhatsAppNumber"
                                   class="form-control" />

                        </div>

                    </div>

                </div>

            </div>


            <!-- Address -->

            <div class="col-lg-6">

                <div class="card shadow border-0">

                    <div class="card-header bg-white">

                        <h5 class="mb-0">

                            <i class="bi bi-geo-alt-fill"></i>

                            Shop Address

                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="mb-3">

                            <label asp-for="Address"
                                   class="form-label">
                                Address
                            </label>

                            <textarea asp-for="Address"
                                      class="form-control"
                                      rows="3">
                            </textarea>

                        </div>

                        <div class="row">

                            <div class="col-md-7">

                                <div class="mb-3">

                                    <label asp-for="City"
                                           class="form-label">
                                        City
                                    </label>

                                    <input asp-for="City"
                                           class="form-control" />

                                </div>

                            </div>

                            <div class="col-md-5">

                                <div class="mb-3">

                                    <label asp-for="Pincode"
                                           class="form-label">
                                        Pincode
                                    </label>

                                    <input asp-for="Pincode"
                                           class="form-control" />

                                </div>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="GoogleMapsUrl"
                                   class="form-label">
                                Google Maps URL
                            </label>

                            <textarea asp-for="GoogleMapsUrl"
                                      class="form-control"
                                      rows="3">
                            </textarea>

                        </div>

                    </div>

                </div>

            </div>


            <!-- WhatsApp -->

            <div class="col-lg-6">

                <div class="card shadow border-0">

                    <div class="card-header bg-white">

                        <h5 class="mb-0">

                            <i class="bi bi-whatsapp"></i>

                            WhatsApp Settings

                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="mb-3">

                            <label asp-for="WhatsAppMessage"
                                   class="form-label">
                                Default WhatsApp Message
                            </label>

                            <textarea asp-for="WhatsAppMessage"
                                      class="form-control"
                                      rows="6">
                            </textarea>

                            <div class="form-text">

                                This message will be loaded when
                                customers click the WhatsApp button.

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Logo -->

            <div class="col-lg-6">

                <div class="card shadow border-0">

                    <div class="card-header bg-white">

                        <h5 class="mb-0">

                            <i class="bi bi-image"></i>

                            Website Logo

                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="mb-3">

                            <label asp-for="LogoPath"
                                   class="form-label">
                                Logo Path
                            </label>

                            <input asp-for="LogoPath"
                                   class="form-control"
                                   placeholder="/images/logo/logo.png" />

                        </div>

                        @if (!string.IsNullOrEmpty(Model.LogoPath))
                        {
                            <div class="mt-3">

                                <p class="mb-2">
                                    Current Logo
                                </p>

                                <img src="@Model.LogoPath"
                                     alt="Shop Logo"
                                     style="max-height:100px;"
                                     class="img-thumbnail" />

                            </div>
                        }

                    </div>

                </div>

            </div>


            <!-- Save -->

            <div class="col-12">

                <div class="d-flex justify-content-end">

                    <button type="submit"
                            class="btn btn-primary px-4">

                        <i class="bi bi-save"></i>

                        Save Settings

                    </button>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}