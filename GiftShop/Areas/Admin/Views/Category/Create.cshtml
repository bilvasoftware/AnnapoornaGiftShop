@model GiftShop.Areas.Admin.ViewModels.CategoryViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Category";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h3>Add New Category</h3>

    <a asp-area="Admin"
       asp-controller="Category"
       asp-action="Index"
       class="btn btn-outline-secondary">
        ← Back
    </a>

</div>

<div class="card shadow-sm border-0 rounded-4">

    <div class="card-body p-4">

        <!-- Validation Summary -->
        <div asp-validation-summary="All" class="alert alert-danger"></div>

        @if (ViewBag.Errors != null)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (string error in ViewBag.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <form asp-area="Admin"
              asp-controller="Category"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="mb-3">

                <label asp-for="CategoryName" class="form-label"></label>

                <input asp-for="CategoryName" class="form-control" />

                <span asp-validation-for="CategoryName" class="text-danger"></span>

            </div>

            <div class="mb-3">

                <label asp-for="DisplayOrder" class="form-label"></label>

                <input asp-for="DisplayOrder" class="form-control" />

                <span asp-validation-for="DisplayOrder" class="text-danger"></span>

            </div>

            <div class="form-check form-switch mb-4">

                <input asp-for="IsActive"
                       class="form-check-input"
                       type="checkbox" />

                <label asp-for="IsActive" class="form-check-label"></label>

            </div>

            <div class="mb-3">

                <label asp-for="ImageFile" class="form-label">
                    Category Image
                </label>

                <input asp-for="ImageFile"
                       class="form-control"
                       type="file"
                       id="imageInput"
                       accept="image/*" />

            </div>

            <div class="mb-4">

                <img id="previewImage"
                     src="https://placehold.co/250x250?text=Preview"
                     class="img-thumbnail"
                     style="width:220px;height:220px;object-fit:cover;" />

            </div>

            <button type="submit" class="btn btn-primary px-5">
                Save Category
            </button>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.getElementById("imageInput")
            .addEventListener("change", function (e) {

                const file = e.target.files[0];

                if (file) {

                    const reader = new FileReader();

                    reader.onload = function (ev) {

                        document.getElementById("previewImage").src = ev.target.result;

                    };

                    reader.readAsDataURL(file);

                }

            });

    </script>

}