@model GiftShop.Areas.Admin.ViewModels.CategoryViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Category";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h3>Edit Category</h3>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        ← Back
    </a>

</div>

<div class="card shadow-sm border-0 rounded-4">

    <div class="card-body p-4">

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input asp-for="CategoryId" type="hidden" />

            <input asp-for="ExistingImage" type="hidden" />

            <div class="mb-3">

                <label asp-for="CategoryName" class="form-label"></label>

                <input asp-for="CategoryName" class="form-control" />

                <span asp-validation-for="CategoryName"
                      class="text-danger"></span>

            </div>

            <div class="mb-3">

                <label asp-for="DisplayOrder" class="form-label"></label>

                <input asp-for="DisplayOrder" class="form-control" />

            </div>

            <div class="form-check form-switch mb-4">

                <input asp-for="IsActive"
                       class="form-check-input" />

                <label asp-for="IsActive"
                       class="form-check-label">
                </label>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Current Image
                </label>

                <br />

                <img id="previewImage"
                     src="~/images/categories/@Model.ExistingImage"
                     class="img-thumbnail"
                     style="width:220px;height:220px;object-fit:cover;" />

            </div>

            <div class="mb-4">

                <label asp-for="ImageFile"
                       class="form-label">
                    Replace Image
                </label>

                <input asp-for="ImageFile"
                       type="file"
                       id="imageInput"
                       class="form-control"
                       accept="image/*" />

            </div>

            <button type="submit"
                    class="btn btn-success px-5">

                Save Changes

            </button>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.getElementById("imageInput")
        .addEventListener("change",function(e){

            const file=e.target.files[0];

            if(file){

                const reader=new FileReader();

                reader.onload=function(ev){

                    document.getElementById("previewImage").src=ev.target.result;

                }

                reader.readAsDataURL(file);

            }

        });

    </script>

}